# ── AI Provider ──────────────────────────────────────────────────────────────
GROQ_API_KEY=
AI_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./cloudguard.db

# ── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production

# ── AWS Credentials (leave empty for demo mode) ──────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ── Notifications (optional) ─────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
CUSTOM_WEBHOOK_URL=
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=cloudguard@localhost
EMAIL_TO=

# ── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
